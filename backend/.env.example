# Backend environment — copy to backend/.env and fill in real values.
# backend/.env is gitignored and must NEVER be committed (holds live secrets).

# Postgres connection string (Supabase → Project settings → Database → Connection string)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase project URL (Project settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SECRET / service_role key (Project settings → API) — server-only, keep secret
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Port the Express server listens on (Railway sets this automatically in prod)
PORT=3000

# --- DB TLS verification (optional; leave BOTH unset to keep the encrypted-but-unverified default) ---
# By default the Postgres connection is TLS-encrypted but the server cert is NOT verified
# (Supabase's pooler cert isn't in the system trust store). To turn verification ON, set ONE:
#   DATABASE_CA_CERT — the provider's CA cert as PEM text (multi-line OK) OR a path to a .pem file.
#   DATABASE_SSL_STRICT=true — verify against the system CA store (only if the DB cert is publicly trusted).
# Setting either flips rejectUnauthorized on. Verify the backend still connects after enabling.
# DATABASE_CA_CERT=
# DATABASE_SSL_STRICT=false

# Anthropic API key for the coach/insights (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Contact-form email forwarding via Resend (https://resend.com) HTTP API.
# Railway's Hobby plan blocks outbound SMTP, so we send over HTTPS instead.
# If RESEND_API_KEY is unset, contact messages are stored in the DB only (not emailed).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender — must be an address on a domain you've verified in Resend.
CONTACT_FROM=UpVital <no-reply@send.upvital.app>
# Where messages are delivered (defaults to support@upvital.app).
CONTACT_TO=support@upvital.app
# Cloudflare Turnstile secret for the website contact form (the same widget as the app's
# sign-up — its secret key, from Cloudflare → Turnstile). Unset = CAPTCHA not enforced.
TURNSTILE_SECRET_KEY=0x4AAAAAAA-your-turnstile-secret
# Shared secret for the welcome-email trigger. The Supabase trigger in
# db/hooks/welcome-email-on-confirm.sql sends this in the x-welcome-secret header;
# it must match here or /internal/welcome 401s. Generate with: openssl rand -hex 32
WELCOME_HOOK_SECRET=change-me-openssl-rand-hex-32

# --- Cloudflare-only origin lock (optional; keep OFF until all clients reach the API through Cloudflare) ---
# When "true", the backend rejects any request that doesn't carry the X-Origin-Secret header
# that a Cloudflare Transform Rule injects on the api.upvital.app zone. Closes the raw
# *.up.railway.app bypass. /health stays exempt (Railway platform healthcheck).
REQUIRE_CLOUDFLARE_ORIGIN=false
# Shared secret (>=16 chars). Must equal the value the Cloudflare Transform Rule sets. Generate: openssl rand -hex 32
ORIGIN_SHARED_SECRET=

# Sign in with Apple key (Apple Developer → Keys, "Sign in with Apple" ticked) — used to revoke a
# user's Apple sign-in when they delete their account. Team ID + the key's 10-character Key ID +
# the .p8 file's contents (line breaks may be written as \n). Unset = deletion still works, the
# Apple link just isn't revoked.
APPLE_TEAM_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
