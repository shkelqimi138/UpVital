# Normalize line endings: text files are stored as LF in the repo and checked
# out as-is, so the tree is identical on macOS, Linux and Windows.
* text=auto eol=lf

# Binary assets — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff2 binary
*.p8    binary
*.p12   binary
