# Mobile environment — copy to mobile/.env and fill in.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so they are
# PUBLIC (safe to ship). After editing, restart Metro with a clear: `npx expo start -c`.

# Supabase project URL — same value as backend SUPABASE_URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (Project settings → API → anon public key) — public
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Backend base URL (Railway deployment, or http://localhost:3000 for the Simulator)
EXPO_PUBLIC_API_URL=https://api.upvital.app

# Cloudflare Turnstile SITE key (public — safe to ship). dash.cloudflare.com → Turnstile.
# Until set, the CAPTCHA widget no-ops and auth works as before.
EXPO_PUBLIC_TURNSTILE_SITEKEY=0xXXXXXXXXXXXXXXXXXXXX
